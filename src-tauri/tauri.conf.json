{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aqiflow",
  "version": "0.1.0",
  "identifier": "com.aqiflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Aqiflow",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 24 },
        "transparent": true,
        "dragDropEnabled": false,
        "windowEffects": { "effects": ["sidebar"], "state": "followsWindowActiveState" }
      },
      {
        "label": "quick",
        "title": "Quick Add",
        "width": 680,
        "height": 132,
        "center": true,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "public.app-category.productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
